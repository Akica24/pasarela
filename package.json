{
  "name": "pasarela",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pasarela — Tienda virtual de calzado. Proyecto educativo Ruta Avanzada (Frontend + Backend con Node.js y MySQL).",
  "scripts": {
    "serve": "npx --yes serve -l 8000 .",
    "backend": "node --env-file=.env backend/server.js",
    "backend:dev": "node backend/server.js",
    "create-admin": "node --env-file=.env backend/scripts/createAdmin.js",
    "db:schema": "mysql -u root -p < database/schema.sql",
    "db:seed": "mysql -u root -p tienda_zapatos < database/seed.sql"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  },
  "dependencies": {
    "mysql2": "^3.24.6"
  }
}